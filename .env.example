# Copy to .env for local development. Values below match docker-compose.yml.
# Never commit real secrets; production uses a managed vault.

# App
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://oportfolio:oportfolio_dev@localhost:5432/oportfolio

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
# Endpoint the *browser* can reach for presigned uploads/downloads.
# Must differ from S3_ENDPOINT only when the app runs inside Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=oportfolio
S3_SECRET_ACCESS_KEY=oportfolio_dev
S3_BUCKET_QUARANTINE=oportfolio-quarantine
S3_BUCKET_CLEAN=oportfolio-clean

# ClamAV daemon
CLAMD_HOST=localhost
CLAMD_PORT=3310

# SMTP (Mailpit locally; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="oPortfolio <no-reply@oportfolio.local>"

# Demo quick sign-in for the seeded synthetic accounts (@example.org only).
# NEVER set to true in any environment that holds real accounts.
DEMO_LOGIN=false
