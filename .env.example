# Copy to .env for local development. Values below match docker-compose.yml.
# Never commit real secrets. In production every value comes from the
# platform's secret store; the app refuses to start with these development
# values when NODE_ENV=production (src/server/config/env.ts, docs/deployment.md).

# App
APP_BASE_URL=http://localhost:3000        # production: https://diary.example.nhs.uk
NODE_ENV=development

# PostgreSQL — production: append ?sslmode=verify-full for TLS to the database
DATABASE_URL=postgres://oportfolio:oportfolio_dev@localhost:5432/oportfolio

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
# Endpoint the *browser* can reach for presigned uploads/downloads.
# Must differ from S3_ENDPOINT only when the app runs inside Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=oportfolio
S3_SECRET_ACCESS_KEY=oportfolio_dev
S3_BUCKET_QUARANTINE=oportfolio-quarantine
S3_BUCKET_CLEAN=oportfolio-clean
S3_BUCKET_EXPORT=oportfolio-exports

# ClamAV daemon
CLAMD_HOST=localhost
CLAMD_PORT=3310

# SMTP (Mailpit locally; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="oPortfolio <no-reply@oportfolio.local>"
# Production relay: authenticated and encrypted.
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SECURE=false          # true for implicit TLS on 465
#SMTP_REQUIRE_TLS=true      # STARTTLS mandatory (default in production)

# Reverse proxies between the internet and the app (for X-Forwarded-For).
# 0 = ignore the header. Defaults: 0 in development, 1 in production.
#TRUSTED_PROXY_HOPS=1

# RFC 9116 vulnerability disclosure (served at /.well-known/security.txt when set)
#SECURITY_CONTACT=security@example.nhs.uk
#SECURITY_POLICY_URL=https://example.nhs.uk/security-policy

# Synthetic fixtures (`pnpm seed`) are refused in production unless ALLOW_SEED=1
#ALLOW_SEED=0
