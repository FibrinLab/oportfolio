{
  "name": "oportfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Independent private diary for personal learning and reflection",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "invite": "tsx scripts/invite.ts",
    "framework:import": "tsx scripts/framework-import.ts",
    "verify:audit-chain": "tsx scripts/verify-audit-chain.ts",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:authz": "vitest run --project authz",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "@aws-sdk/s3-presigned-post": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "file-type": "^22.0.1",
    "jspdf": "^3.0.4",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "pg-cloudflare": "1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.127.1"
  }
}
